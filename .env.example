# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, AWS RDS, or local Postgres)
# In production on Vercel/Neon, pooled connection URL is recommended:
DATABASE_URL="postgresql://postgres:password@localhost:5432/portfolio_db?schema=public"
# Direct URL for migrations if using connection pooling (e.g. Supabase port 5432 vs 6543):
# DIRECT_URL="postgresql://postgres:password@localhost:5432/portfolio_db?schema=public"

# ==========================================
# Authentication & Security
# ==========================================
# Secret key used for signing session JWT tokens (generate using: openssl rand -base64 32)
AUTH_SECRET="change-this-to-a-super-secure-32-byte-hex-or-base64-secret"

# Initial admin setup credentials (used by `npm run admin:create`)
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_PASSWORD="SecureAdminPassword123!"
ADMIN_NAME="Portfolio Architect"

# ==========================================
# Application Settings & Origins
# ==========================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Cloudinary / Object Storage (if configuring external cloud uploads)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
